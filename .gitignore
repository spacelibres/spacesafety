# 依赖与构建产物
node_modules/
.next/
out/
.venv/
.venv-dl/

# 证书：只有服务端/客户端密钥不能入库。
# ca.crt、client.crt、identity.json 是公开信息，用于让读者知道证书的形态。
certs/ca.key
certs/client.key
certs/*.srl
# 任何新签发的客户端凭证：私钥与证书都是特定部署的产物，不属于代码仓库。
# 早先只列了 ca.key / client.key / *.srl，于是新签的 catalog-client.key 没有被忽略，
# 差一点被提交。
certs/*.key
certs/*.csr
certs/*.ext
certs/*-client.crt
!certs/ca.crt
!certs/client.crt

# 环境与凭据
.env
.env.local
.env.*.local
*.pem
*.p12
*.pfx

# 本地计算数据：星历缓存、数据库、Spacebook 下载源文件。
# 这些是几十 GB 量级，永远不进版本库；仓库里只保存可以重新下载/重新计算的脚本。
data/*
!data/.gitkeep
# 例外：参考数据的说明文档是项目文档，必须入库；数据文件本身仍然忽略。
!data/reference/
!data/reference/README.md
# 但 data/reference/ 下的实际数据仍然不入库。
data/reference/*
!data/reference/README.md

# 运行时产物
*.log
*.tsbuildinfo
/tmp/

# 数据库文件。`data/*` 已经忽略，但脚本里一处相对的 ATTACH 路径曾在仓库
# 根目录凭空建出一个 0 字节的 catalogue-wide.sqlite 并被提交，所以这里再兜一层：
# 任何位置的 sqlite 文件都不属于代码仓库。
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# 生成物：星座快照由 `npm run build:snapshot` 从 TLE 重新生成（12 MB），
# Cesium 的运行时资源由 `npm install` 后的拷贝脚本填充。两者都不进版本库，
# 否则每次构建都会产生一个无法审阅的巨大 diff。
/public/data/
/public/cesium/

# 崩溃转储。必须带锚点：裸写 `core` 会连同 `src/lib/core/`（计算内核）
# 一起忽略，仓库里就会缺掉整个筛查内核而看似正常。
/core
/core.*
/core.[0-9]*

# 编辑器与系统
.DS_Store
.idea/
.vscode/
*.swp
