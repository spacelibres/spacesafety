# Space Safety 环境变量
#
# 全部变量以 SPACE_SAFETY_ 为前缀。复制为 .env.local 后填写；
# .env.local 已被 .gitignore 排除，不会进入版本库。
#
# 变量名与代码一一对应：改名前请先 grep 代码中的读取点，
# 否则程序会静默退回默认值。

# --- 演示与认证 ---------------------------------------------------------------
# 同时置 1 时，允许用 x-space-safety-operator 头代替 mTLS 证书（仅用于本机调试）。
# 生产环境缺少这条组合时 API 一律返回 401。
SPACE_SAFETY_DEMO=
SPACE_SAFETY_ALLOW_X_OPERATOR=

# 内部计算节点与入口层之间的共享令牌。
SPACE_SAFETY_WORKER_TOKEN=
SPACE_SAFETY_ADMIN=

# 对外 API 的规范地址，用于响应体中的自引用链接。
SPACE_SAFETY_API_ORIGIN=

# --- 存储 ---------------------------------------------------------------------
# SQLite 数据库。相对路径按项目根目录解析。
SPACE_SAFETY_DB=./data/spacesafety.sqlite
# 星历文件缓存目录（原始 OCM/OEM 文本）。
SPACE_SAFETY_CACHE_DIR=./data/ephemeris-cache
# 旧版按文件存放轨迹的目录，仅在迁移时使用。
SPACE_SAFETY_TRAJECTORY_DIR=
SPACE_SAFETY_CACHE=

# --- 数据源 -------------------------------------------------------------------
# Space-Track.org 凭据，用于 TLE/OMM 的 NORAD 解析与 SGP4 传播。
SPACE_SAFETY_SPACETRACK_USER=
SPACE_SAFETY_SPACETRACK_PASS=
SPACE_SAFETY_SPACETRACK_TIMEOUT_MS=
# 出站 HTTP 代理。留空表示直连——starlink.com 对普通浏览器 GET 会返回完整文件，
# 此前看到的截断来自 Range 请求，不是网络问题。
SPACE_SAFETY_PROXY=

# --- 计算 ---------------------------------------------------------------------
# 工作线程数与每线程并发。
SPACE_SAFETY_WORKER_THREADS=
SPACE_SAFETY_WORKER_CONCURRENCY=
# 每个线程持有的打包轨迹字节预算（MB）。0 表示不驱逐。
SPACE_SAFETY_THREAD_MEMORY_MB=
# 每线程保留的原始星历字符上限。
SPACE_SAFETY_THREAD_CACHE_CHARS=
# 内核内容缓存条数。
SPACE_SAFETY_TRACK_CACHE=
# 全量筛查驱动的主堆上限（MB），由 screen-parallel 重新 exec 时使用。
SPACE_SAFETY_HEAP_MB=

# --- 筛查参数（一般无需修改） -------------------------------------------------
SPACE_SAFETY_PRIMARY=
SPACE_SAFETY_HORIZON_HOURS=
SPACE_SAFETY_INC_DELTA_DEG=
SPACE_SAFETY_CROSS_BIAS_KM=
SPACE_SAFETY_OCM_SAMPLE=
SPACE_SAFETY_PACK_CACHE_MB=
SPACE_SAFETY_RISK_THRESHOLDS=
SPACE_SAFETY_BENCH_REAL=

# --- gRPC（入口层 <-> 计算节点） ----------------------------------------------
SPACE_SAFETY_GRPC_HOST=
SPACE_SAFETY_GRPC_PORT=
SPACE_SAFETY_GRPC_INSECURE=
SPACE_SAFETY_GRPC_CA=
SPACE_SAFETY_GRPC_CERT=
SPACE_SAFETY_GRPC_KEY=
SPACE_SAFETY_PROTO=

# --- 本地开发/工具 ------------------------------------------------------------
SPACE_SAFETY_ENV=
SPACE_SAFETY_CERT_DIR=./certs
SPACE_SAFETY_PORT=3000
